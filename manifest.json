{
  "manifest_version": 3,
  "name": "Codex Usage Fix",
  "version": "1.0.0",
  "description": "Mostra a porcentagem de USO (e não a restante) nos limites do Codex em chatgpt.com/settings/usage.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
